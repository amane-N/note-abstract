{
  "manifest_version": 3,
  "name": "note アブストラクト",
  "version": "0.1.0",
  "description": "note.com の記事を要約・分析する Chrome 拡張機能",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://note.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://note.com/*/n/*"],
      "js": [
        "src/lib/crypto.js",
        "src/lib/storage.js",
        "src/lib/license.js",
        "src/lib/note-parser.js",
        "src/lib/error-classifier.js",
        "src/lib/gemini-client.js",
        "src/lib/nano-summarizer.js",
        "src/lib/predictor.js",
        "src/lib/keyword-suggester.js",
        "src/lib/exporter.js",
        "src/content/side-panel.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/templates/prompts.json",
        "docs/privacy-policy.md",
        "docs/terms-of-use.md"
      ],
      "matches": ["https://note.com/*"]
    }
  ],
  "action": {
    "default_title": "note アブストラクト (記事ページでクリック / Ctrl+Shift+Y)",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png"
    }
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "note アブストラクトのサイドパネルを開閉する"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
